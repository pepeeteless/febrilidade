{
  "name": "febrilidade",
  "version": "1.0.0",
  "description": "Sistema de módulos para profissionais da saúde em construção.",
  "homepage": "https://github.com/pepeeteless/febrilidade#readme",
  "bugs": {
    "url": "https://github.com/pepeeteless/febrilidade/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepeeteless/febrilidade.git"
  },
  "license": "ISC",
  "author": "pepe and ramon",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run wait-for-services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check",
    "lint:prettier:fix": "prettier --write",
    "lint:eslint:check": "npx eslint .",
    "wait-for-services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "commit": "cz"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "commitizen": "^4.3.0",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "prettier": "3.9.5"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "dotenv": "^17.4.2",
    "next": "^16.2.10",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
